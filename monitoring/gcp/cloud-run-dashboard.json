{
  "displayName": "Gyeol — Cloud Run 성능",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "width": 6, "height": 4, "xPos": 0, "yPos": 0,
        "widget": {
          "title": "요청 수 (서비스별)",
          "xyChart": {
            "dataSets": [{
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": ["resource.label.service_name"]
                  }
                }
              },
              "plotType": "LINE"
            }],
            "yAxis": { "label": "req/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "width": 6, "height": 4, "xPos": 6, "yPos": 0,
        "widget": {
          "title": "요청 지연시간 p50 / p95 / p99",
          "xyChart": {
            "dataSets": [
              {
                "legendTemplate": "p50 ${resource.labels.service_name}",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_50",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": ["resource.label.service_name"]
                    }
                  }
                },
                "plotType": "LINE"
              },
              {
                "legendTemplate": "p95 ${resource.labels.service_name}",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_95",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": ["resource.label.service_name"]
                    }
                  }
                },
                "plotType": "LINE"
              },
              {
                "legendTemplate": "p99 ${resource.labels.service_name}",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_99",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": ["resource.label.service_name"]
                    }
                  }
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": { "label": "ms", "scale": "LINEAR" }
          }
        }
      },
      {
        "width": 6, "height": 4, "xPos": 0, "yPos": 4,
        "widget": {
          "title": "인스턴스 수 (오토스케일 / 콜드스타트 관찰)",
          "xyChart": {
            "dataSets": [{
              "legendTemplate": "${resource.labels.service_name} ${metric.labels.state}",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/container/instance_count\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MEAN",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": ["resource.label.service_name", "metric.label.state"]
                  }
                }
              },
              "plotType": "STACKED_AREA"
            }],
            "yAxis": { "label": "인스턴스", "scale": "LINEAR" }
          }
        }
      },
      {
        "width": 6, "height": 4, "xPos": 6, "yPos": 4,
        "widget": {
          "title": "응답 코드별 요청 (에러율)",
          "xyChart": {
            "dataSets": [{
              "legendTemplate": "${resource.labels.service_name} ${metric.labels.response_code_class}",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "groupByFields": ["resource.label.service_name", "metric.label.response_code_class"]
                  }
                }
              },
              "plotType": "STACKED_BAR"
            }],
            "yAxis": { "label": "req/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "width": 6, "height": 4, "xPos": 0, "yPos": 8,
        "widget": {
          "title": "컨테이너 CPU 사용률",
          "xyChart": {
            "dataSets": [{
              "legendTemplate": "${resource.labels.service_name}",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/container/cpu/utilizations\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_95",
                    "crossSeriesReducer": "REDUCE_MEAN",
                    "groupByFields": ["resource.label.service_name"]
                  }
                }
              },
              "plotType": "LINE"
            }],
            "yAxis": { "label": "사용률", "scale": "LINEAR" }
          }
        }
      },
      {
        "width": 6, "height": 4, "xPos": 6, "yPos": 8,
        "widget": {
          "title": "컨테이너 메모리 사용률",
          "xyChart": {
            "dataSets": [{
              "legendTemplate": "${resource.labels.service_name}",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_95",
                    "crossSeriesReducer": "REDUCE_MEAN",
                    "groupByFields": ["resource.label.service_name"]
                  }
                }
              },
              "plotType": "LINE"
            }],
            "yAxis": { "label": "사용률", "scale": "LINEAR" }
          }
        }
      },
      {
        "width": 12, "height": 4, "xPos": 0, "yPos": 12,
        "widget": {
          "title": "컨테이너 시작 지연 (콜드스타트)",
          "xyChart": {
            "dataSets": [{
              "legendTemplate": "${resource.labels.service_name}",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/container/startup_latencies\" resource.type=\"cloud_run_revision\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_95",
                    "crossSeriesReducer": "REDUCE_MEAN",
                    "groupByFields": ["resource.label.service_name"]
                  }
                }
              },
              "plotType": "LINE"
            }],
            "yAxis": { "label": "ms", "scale": "LINEAR" }
          }
        }
      }
    ]
  }
}
